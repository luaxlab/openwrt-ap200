// Device Tree für TP-Link AP200 (QCA9563, AR8033 PHY + SerDes)

#include "qca956x.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
    compatible = "tplink,ap200", "qca,qca9563";
    model = "TP-Link AP200";

    aliases {
        label-mac-device = &eth0;

        led-boot     = &led_power;
        led-failsafe = &led_wps_red;
        led-running  = &led_power;
        led-upgrade  = &led_wps_red;
    };

    leds {
        compatible = "gpio-leds";

        led_power: power {
            function = LED_FUNCTION_POWER;
            color = <LED_COLOR_ID_GREEN>;
            gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
            default-state = "on";
        };

        led_wifi2g: wifi2g {
            function = LED_FUNCTION_WLAN_2GHZ;
            color = <LED_COLOR_ID_GREEN>;
            gpios = <&gpio 19 GPIO_ACTIVE_LOW>;
            default-state = "off";
        };

        led_wifi5g: wifi5g {
            function = LED_FUNCTION_WLAN_5GHZ;
            color = <LED_COLOR_ID_GREEN>;
            gpios = <&gpio 20 GPIO_ACTIVE_LOW>;
            default-state = "off";
        };

        led_lan: lan {
            function = LED_FUNCTION_LAN;
            color = <LED_COLOR_ID_GREEN>;
            gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
            default-state = "off";
        };

        led_wps_red: wps_red {
            function = LED_FUNCTION_WPS;
            color = <LED_COLOR_ID_RED>;
            gpios = <&gpio 5 GPIO_ACTIVE_LOW>;
            default-state = "off";
        };

        led_wps_green: wps_green {
            function = LED_FUNCTION_WPS;
            color = <LED_COLOR_ID_GREEN>;
            gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
            default-state = "off";
        };
    };
};

/* ---------- SPI Flash und NVMEM ---------- */

&spi {
    status = "okay";

    flash@0 {
        compatible = "jedec,spi-nor";
        reg = <0>;
        spi-max-frequency = <25000000>;

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            uboot: partition@0 {
                label = "u-boot";
                reg = <0x000000 0x10000>;
                read-only;
            };

            partition@10000 {
                label = "info";
                reg = <0x10000 0x10000>;
                read-only;

                nvmem-layout {
                    compatible = "fixed-layout";
                    #address-cells = <1>;
                    #size-cells = <1>;

                    macaddr_info_8: macaddr@8 {
                        compatible = "mac-base";
                        reg = <0x8 0x6>;
                        #nvmem-cell-cells = <1>;
                    };
                };
            };

            firmware: partition@20000 {
                label = "firmware";
                reg = <0x020000 0x7d0000>; /* bis vor ART */
                compatible = "denx,uimage";
            };

            partition@7f0000 {
                label = "art";
                reg = <0x7f0000 0x010000>;
                read-only;

                nvmem-layout {
                    compatible = "fixed-layout";
                    #address-cells = <1>;
                    #size-cells = <1>;

                    cal_art_1000: calibration@1000 {
                        reg = <0x1000 0x440>;
                    };

                    cal_art_5000: calibration@5000 {
                        reg = <0x5000 0x844>;
                    };
                };
            };
        };
    };
};

/* ---------- Ethernet ---------- */

&pinmux {
	mdio_pins: mdio_pins {
		pinctrl-single,bits = <
            /* GPIO3 -> GE0_MDC */
            0x0  0x21000000 0xff000000

            /* GPIO4 -> GE0_MDO */
            0x4  0x00000020 0x000000ff

            /* GE0_MDI -> GPIO4 */
            0x24 0x00040000 0x00ff0000
        >;
	};
};

&mdio0 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;

    phy4: ethernet-phy@4 {
		reg = <4>;
		reset-gpios = <&gpio 11 GPIO_ACTIVE_LOW>;
	};
};


&eth0 {
    status = "okay";
    phy-mode = "sgmii";
    phy-handle = <&phy4>;

    // Vendor SerDes / PLL Konfiguration
    pll-data = <0x06000000 0x00000101 0x00001919>;
    phy-mask = <0x10>;

    // Erzwingt SerDes Init im Kernel
    qca956x-serdes-fixup;

    // MAC-Adresse aus NVMEM
    nvmem-cells = <&macaddr_info_8 0>;
    nvmem-cell-names = "mac-address";

	gmac-config {
		device = <&gmac>;
	};

};


/* ---------- Wireless ---------- */

&wmac {
    status = "okay";
    nvmem-cells = <&macaddr_info_8 0>, <&cal_art_1000>;
    nvmem-cell-names = "mac-address", "calibration";
};
